    "web:legacy": "npm run manager:prepare && EXPO_PUBLIC_SHENLONG_EXPERIMENT=0 EXPO_PUBLIC_MANAGER_LAYOUT=legacy expo start --web --port 8081 --max-workers 2",
    "export:manager": "npm run manager:prepare && EXPO_PUBLIC_SHENLONG_EXPERIMENT=0 EXPO_PUBLIC_MANAGER_LAYOUT=modern expo export --platform web",
    "export:legacy": "npm run manager:prepare && EXPO_PUBLIC_SHENLONG_EXPERIMENT=0 EXPO_PUBLIC_MANAGER_LAYOUT=legacy expo export --platform web",
    "android:manager": "npm run manager:prepare && node scripts/apply-native-screens-patch.cjs && EXPO_PUBLIC_SHENLONG_EXPERIMENT=0 EXPO_PUBLIC_MANAGER_LAYOUT=modern expo run:android",
