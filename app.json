{
  "expo": {
    "name": "On Gestor",
    "displayName": "On Gestor",
    "slug": "manager-controle-online",
    "platforms": [
      "android",
      "ios",
      "web"
    ],
    "jsEngine": "hermes",
    "android": {
      "jsEngine": "hermes",
      "package": "com.controleonline.manager",
      "versionCode": 1287,
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/manager/logo.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "VIBRATE",
        "INTERNET",
        "WAKE_LOCK",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ],
      "tvBanner": "./src/assets/tv.png"
    },
    "icon": "./src/assets/manager/logo.png",
    "splash": {
      "image": "./src/assets/manager/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "jsEngine": "hermes",
      "bundleIdentifier": "com.controleonline.manager",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Necessário para processamento de áudio.",
        "NSAppleMusicUsageDescription": "Necessário para emitir alertas sonoros.",
        "UIBackgroundModes": [
          "audio"
        ]
      }
    },
    "web": {
      "favicon": "./src/assets/manager/logo.png"
    },
    "plugins": [
      "./withAndroidTV",
      "expo-build-properties",
      "expo-asset",
      "expo-font",
      "react-native-iap",
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": true
        }
      ]
    ]
  }
}