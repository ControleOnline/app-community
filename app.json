{
  "expo": {
    "name": "On Gestor",
    "displayName": "On Gestor",
    "slug": "manager-controle-online",
    "platforms": [
      "android",
      "ios",
      "web"
    ],
    "jsEngine": "hermes",
    "version": "1.3.45",
    "android": {
      "jsEngine": "hermes",
      "package": "com.controleonline.manager",
      "versionCode": 1345,
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/manager/logo.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "VIBRATE",
        "INTERNET",
        "WAKE_LOCK",
        "POST_NOTIFICATIONS",
        "CAMERA"
      ],
      "tvBanner": "./src/assets/tv.png"
    },
    "icon": "./src/assets/manager/logo.png",
    "splash": {
      "image": "./src/assets/manager/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "jsEngine": "hermes",
      "bundleIdentifier": "com.controleonline.manager",
      "infoPlist": {
        "NSCameraUsageDescription": "Necessário para ler códigos de barras e QR Codes no PDV.",
        "NSMicrophoneUsageDescription": "Necessário para processamento de áudio.",
        "NSAppleMusicUsageDescription": "Necessário para emitir alertas sonoros.",
        "UIBackgroundModes": [
          "audio"
        ]
      }
    },
    "web": {
      "favicon": "./src/assets/manager/logo.png"
    },
    "plugins": [
      "./withAndroidTV",
      "./withKioskMode",
      "./withBackgroundRuntime",
      "./withVectorIconsFonts",
      [
        "expo-build-properties",
        {
          "android": {
            "kotlinVersion": "2.2.0"
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Necessário para ler códigos de barras e QR Codes no PDV.",
          "microphonePermission": "Necessário para processamento de áudio.",
          "recordAudioAndroid": false
        }
      ],
      "expo-asset",
      "expo-font",
      "expo-notifications",
      "react-native-iap",
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": false
        }
      ]
    ]
  }
}
