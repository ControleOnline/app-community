private fun safeTrim(value: Any?): String = value?.toString()?.trim().orEmpty()

private fun normalizeDeviceId(value: Any?): String = safeTrim(value)

private fun normalizeOrderId(value: Any?): String {
  return when (value) {
    is JSONObject ->
      normalizeOrderId(
        value.opt("@id").takeIf { it != null } ?: value.opt("id")
          ?: value.opt("order"),
      )

    else -> safeTrim(value).replace(Regex("\\D+"), "")
  }
}

private fun parseNumericValue(value: Any?): Double? {
  if (value == null || value == JSONObject.NULL) {
    return null
  }

  return when (value) {
    is Number -> value.toDouble()
    else -> {
      val normalizedValue = safeTrim(value)
      if (normalizedValue.isEmpty()) {
        null
      } else {
        val sanitizedValue = normalizedValue
          .replace(Regex("[^\\d,.-]"), "")
          .replace(Regex("\\.(?=\\d{3}(?:\\D|$))"), "")
          .replace(',', '.')
        sanitizedValue.toDoubleOrNull()
      }
    }
  }?.takeIf { !it.isNaN() && !it.isInfinite() }
}

private fun formatMoneyLabel(value: Any?): String {
  val numericValue = parseNumericValue(value) ?: return ""
  if (numericValue <= 0.0) {
    return ""
  }

  return NumberFormat.getCurrencyInstance(Locale.forLanguageTag("pt-BR"))
    .format(numericValue)
}

private fun resolveDisplayName(value: Any?): String {
  if (value == null || value == JSONObject.NULL) {
    return ""
  }

  return when (value) {
    is JSONObject -> safeTrim(value.opt("alias"))
      .ifEmpty { safeTrim(value.opt("name")) }
    else -> {
      val normalizedValue = safeTrim(value)
      if (normalizedValue.startsWith("/")) {
        ""
      } else {
        normalizedValue
      }
    }
  }
}

private fun resolveOrderCustomerName(order: JSONObject?): String {
  if (order == null) {
    return ""
  }

  return resolveDisplayName(order.opt("client").takeIf { it != null })
    .ifEmpty { resolveDisplayName(order.opt("customer").takeIf { it != null }) }
    .ifEmpty { resolveDisplayName(order.opt("person").takeIf { it != null }) }
}

private fun parseStringArray(values: JSONArray?): List<String> {
  if (values == null) {
    return emptyList()
  }

  return buildList {
    for (index in 0 until values.length()) {
      val normalizedValue = safeTrim(values.opt(index))
      if (normalizedValue.isNotEmpty()) {
        add(normalizedValue)
      }
    }
  }
}

private fun jsonCompatibleValue(value: Any?): Any? {
  if (value == null || value == JSONObject.NULL) {
    return JSONObject.NULL
  }

  return when (value) {
    is JSONObject,
    is JSONArray,
    is Boolean,
    is Int,
    is Long,
    is Double,
    is Float,
    is Short,
    is Byte,
    is Number,
    is String -> value

    is Map<*, *> -> buildJsonObject(
      value.entries
        .mapNotNull { entry ->
          val key = safeTrim(entry.key)
          if (key.isEmpty()) {
            return@mapNotNull null
          }

          key to entry.value
        }
        .toMap(),
    )

    is Iterable<*> -> JSONArray().apply {
      value.forEach { put(jsonCompatibleValue(it)) }
    }

    is Array<*> -> JSONArray().apply {
      value.forEach { put(jsonCompatibleValue(it)) }
    }

    else -> value.toString()
  }
}

private fun buildJsonObject(values: Map<String, Any?>): JSONObject {
  val json = JSONObject()

  values.forEach { (key, value) ->
    if (key.isBlank() || value == null) {
      return@forEach
    }

    json.put(key, jsonCompatibleValue(value))
  }

  return json
}

private fun buildRuntimeDebugContext(
  registration: RuntimeRegistration,
  context: Map<String, Any?> = emptyMap(),
): JSONObject {
  val payload = linkedMapOf<String, Any?>(
    "runtimeSource" to "background-runtime",
    "registrationId" to registration.registrationId,
    "packageName" to registration.packageName,
    "companyId" to registration.companyId,
    "deviceId" to registration.deviceId,
    "appType" to registration.appType,
    "deviceType" to registration.deviceType,
    "backgroundEnabled" to registration.backgroundEnabled,
    "notificationEnabled" to registration.notificationEnabled,
    "runtimeDebugInfoEnabled" to registration.runtimeDebugInfoEnabled,
  )

  context.forEach { (key, value) ->
    if (key.isNotBlank() && value != null) {
      payload[key] = value
    }
  }

  return buildJsonObject(payload)
}

internal data class RuntimeRegistrationScopeKey(
  val packageName: String,
  val deviceId: String,
  val companyId: String,
)

private fun RuntimeRegistration.scopeKey(): RuntimeRegistrationScopeKey {
  return RuntimeRegistrationScopeKey(
    packageName = packageName,
    deviceId = deviceId,
    companyId = companyId,
  )
}

internal fun pruneRuntimeRegistrations(
  registrations: Collection<RuntimeRegistration>,
  now: Long = System.currentTimeMillis(),
): Map<String, RuntimeRegistration> {
  val pruned = linkedMapOf<RuntimeRegistrationScopeKey, RuntimeRegistration>()

  registrations
    .filter { !it.isExpired(now) }
    .sortedWith(
      compareByDescending<RuntimeRegistration> { it.updatedAt }
        .thenBy { it.registrationId },
    )
    .forEach { registration ->
      val key = registration.scopeKey()
      if (!pruned.containsKey(key)) {
        pruned[key] = registration
      }
    }

  return pruned.values.associateBy { it.registrationId }
}

internal fun selectSocketOwnerRegistrationCandidate(
  registrations: Collection<RuntimeRegistration>,
): RuntimeRegistration? {
  return registrations
    .filter { it.isSocketCapable() }
    .sortedWith(
      compareByDescending<RuntimeRegistration> {
        it.appType.equals("MANAGER", ignoreCase = true)
      }
        .thenByDescending { it.updatedAt }
        .thenBy { it.packageName }
        .thenBy { it.registrationId },
    )
    .firstOrNull()
}

internal data class RuntimeManagedPrinter(
  val deviceId: String,
  val host: String,
  val port: String,
) {
  fun toJson(): JSONObject {
    return JSONObject()
      .put("deviceId", deviceId)
      .put("host", host)
      .put("port", port)
  }

  companion object {
    fun fromJson(json: JSONObject?): RuntimeManagedPrinter? {
      if (json == null) {
        return null
      }

      val deviceId = normalizeDeviceId(json.opt("deviceId"))
      val host = safeTrim(json.opt("host"))
      val port = safeTrim(json.opt("port")).ifEmpty { "9100" }

      if (deviceId.isEmpty() || host.isEmpty()) {
        return null
      }

      return RuntimeManagedPrinter(
        deviceId = deviceId,
        host = host,
        port = port,
      )
    }
  }
}

internal data class RuntimeRegistration(
  val registrationId: String,
  val packageName: String,
  val companyAlias: String,
  val companyId: String,
  val appDomain: String,
  val appType: String,
  val backgroundEnabled: Boolean,
  val deviceId: String,
  val deviceType: String,
  val notificationEnabled: Boolean,
  val alertSoundEnabled: Boolean,
  val alertSoundUrl: String,
  val deviceAlertSoundEnabled: Boolean,
  val deviceAlertSoundUrl: String,
  val userAlertSoundEnabled: Boolean,
  val userAlertSoundUrl: String,
  val printEnabled: Boolean,
  val managedPrinters: List<RuntimeManagedPrinter>,
  val socketUrl: String,
  val spoolDeviceIds: List<String>,
  val token: String,
  val apiBaseUrl: String,
  val runtimeDebugInfoEnabled: Boolean,
  val updatedAt: Long,
) {
  fun toJson(): JSONObject {
    val printerArray = JSONArray()
    managedPrinters.forEach { printerArray.put(it.toJson()) }

    val spoolDeviceArray = JSONArray()
    spoolDeviceIds.forEach { spoolDeviceArray.put(it) }

    return JSONObject()
      .put("registrationId", registrationId)
      .put("packageName", packageName)
      .put("companyAlias", companyAlias)
      .put("companyId", companyId)
      .put("appDomain", appDomain)
      .put("appType", appType)
      .put("backgroundEnabled", backgroundEnabled)
      .put("deviceId", deviceId)
      .put("deviceType", deviceType)
      .put("notificationEnabled", notificationEnabled)
      .put("alertSoundEnabled", alertSoundEnabled)
      .put("alertSoundUrl", alertSoundUrl)
      .put("deviceAlertSoundEnabled", deviceAlertSoundEnabled)
      .put("deviceAlertSoundUrl", deviceAlertSoundUrl)
      .put("userAlertSoundEnabled", userAlertSoundEnabled)
      .put("userAlertSoundUrl", userAlertSoundUrl)
      .put("printEnabled", printEnabled)
      .put("managedPrinters", printerArray)
      .put("socketUrl", socketUrl)
      .put("spoolDeviceIds", spoolDeviceArray)
      .put("token", token)
      .put("apiBaseUrl", apiBaseUrl)
      .put("runtimeDebugInfoEnabled", runtimeDebugInfoEnabled)
      .put("updatedAt", updatedAt)
  }

  fun isExpired(now: Long = System.currentTimeMillis()): Boolean {
    return updatedAt <= 0L || now - updatedAt > REGISTRATION_TTL_MS
  }

  fun isSocketCapable(): Boolean {
    return backgroundEnabled &&
      socketUrl.isNotEmpty() &&
      token.isNotEmpty() &&
      deviceId.isNotEmpty() &&
      !isExpired()
  }

  fun isPrintCapable(): Boolean {
    return backgroundEnabled &&
      printEnabled &&
      apiBaseUrl.isNotEmpty() &&
      token.isNotEmpty() &&
      deviceId.isNotEmpty() &&
      spoolDeviceIds.isNotEmpty() &&
      managedPrinters.isNotEmpty() &&
      !isExpired()
  }

  fun connectionSignature(): String {
    return listOf(
      registrationId,
      deviceId,
      token,
      socketUrl,
      appDomain,
      alertSoundEnabled,
      alertSoundUrl,
      deviceAlertSoundEnabled,
      deviceAlertSoundUrl,
      userAlertSoundEnabled,
      userAlertSoundUrl,
    ).joinToString("|")
  }

  fun resolveAlertSoundUrl(): String {
    if (userAlertSoundEnabled && userAlertSoundUrl.isNotEmpty()) {
      return userAlertSoundUrl
    }

    if (deviceAlertSoundEnabled && deviceAlertSoundUrl.isNotEmpty()) {
      return deviceAlertSoundUrl
    }

    if (alertSoundEnabled && alertSoundUrl.isNotEmpty()) {
      return alertSoundUrl
    }

    return ""
  }

  companion object {
    fun fromJson(
      json: JSONObject,
      fallbackPackageName: String = "",
      fallbackUpdatedAt: Long = System.currentTimeMillis(),
    ): RuntimeRegistration {
      val printerArray = json.optJSONArray("managedPrinters")
      val managedPrinters = buildList {
        if (printerArray != null) {
          for (index in 0 until printerArray.length()) {
            RuntimeManagedPrinter.fromJson(printerArray.optJSONObject(index))
              ?.let { add(it) }
          }
        }
      }

      val registrationId = safeTrim(json.opt("registrationId"))
      if (registrationId.isEmpty()) {
        throw IllegalArgumentException("registrationId is required")
      }

      return RuntimeRegistration(
        registrationId = registrationId,
        packageName = safeTrim(json.opt("packageName")).ifEmpty {
          fallbackPackageName
        },
        companyAlias = safeTrim(json.opt("companyAlias")),
        companyId = safeTrim(json.opt("companyId")),
        appDomain = safeTrim(json.opt("appDomain")),
        appType = safeTrim(json.opt("appType")),
        backgroundEnabled = json.optBoolean("backgroundEnabled", false),
        deviceId = normalizeDeviceId(json.opt("deviceId")),
        deviceType = safeTrim(json.opt("deviceType")),
        notificationEnabled = json.optBoolean("notificationEnabled", true),
        alertSoundEnabled = json.optBoolean("alertSoundEnabled", false),
        alertSoundUrl = safeTrim(json.opt("alertSoundUrl")),
        deviceAlertSoundEnabled = json.optBoolean("deviceAlertSoundEnabled", false),
        deviceAlertSoundUrl = safeTrim(json.opt("deviceAlertSoundUrl")),
        userAlertSoundEnabled = json.optBoolean("userAlertSoundEnabled", false),
        userAlertSoundUrl = safeTrim(json.opt("userAlertSoundUrl")),
        printEnabled = json.optBoolean("printEnabled", false),
        managedPrinters = managedPrinters,
        socketUrl = safeTrim(json.opt("socketUrl")),
        spoolDeviceIds = parseStringArray(json.optJSONArray("spoolDeviceIds")),
        token = safeTrim(json.opt("token")),
        apiBaseUrl = safeTrim(json.opt("apiBaseUrl")),
        runtimeDebugInfoEnabled =
          json.optBoolean("runtimeDebugInfoEnabled", false),
        updatedAt = json.optLong("updatedAt", fallbackUpdatedAt),
      )
    }
  }
}

internal data class RuntimeSocketState(
  val connected: Boolean = false,
  val identified: Boolean = false,
  val status: String = "idle",
  val attempts: Int = 0,
  val updatedAt: Long = System.currentTimeMillis(),
  val device: String = "",
  val error: String = "",
  val code: Int? = null,
  val reason: String = "",
  val ownerRegistrationId: String = "",
  val ownerPackageName: String = "",
  val ownerCompanyId: String = "",
  val lastEventAt: Long? = null,
  val lastEventCount: Int = 0,
  val lastStores: List<String> = emptyList(),
  val lastCompanies: List<String> = emptyList(),
) {
  fun toJson(): JSONObject {
    val json = JSONObject()
      .put("type", "socket-state")
      .put("connected", connected)
      .put("identified", identified)
      .put("status", status)
      .put("attempts", attempts)
      .put("updatedAt", updatedAt)
      .put("lastEventCount", lastEventCount)
      .put("lastStores", JSONArray(lastStores))
      .put("lastCompanies", JSONArray(lastCompanies))

    if (device.isNotBlank()) {
      json.put("device", device)
    }

    if (error.isNotBlank()) {
      json.put("error", error)
    }

    code?.let { json.put("code", it) }

    if (reason.isNotBlank()) {
      json.put("reason", reason)
    }

    if (ownerRegistrationId.isNotBlank()) {
      json.put("ownerRegistrationId", ownerRegistrationId)
    }

    if (ownerPackageName.isNotBlank()) {
      json.put("ownerPackageName", ownerPackageName)
    }

    if (ownerCompanyId.isNotBlank()) {
      json.put("ownerCompanyId", ownerCompanyId)
    }

    lastEventAt?.let { json.put("lastEventAt", it) }

    return json
  }
}

